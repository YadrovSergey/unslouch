---
import Doc from "../../layouts/Doc.astro";
import * as en from "../../../../legal/privacy.en.md";
import * as ru from "../../../../legal/privacy.ru.md";
import { LEGAL_LANGS, langPaths, t, type Lang } from "../../i18n";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
// Legal texts exist in English and Russian only. Other languages show the English text with a notice on top,
// point their canonical to the English page and stay out of the sitemap and hreflang.
const translated = LEGAL_LANGS.includes(lang);
const md = lang === "ru" ? ru : en;
const d = t(lang);
const html = await md.compiledContent();
---

<Doc
  lang={lang}
  path="/privacy/"
  title={d.meta.privacy.title}
  description={d.meta.privacy.description}
  html={html}
  notice={translated ? undefined : d.legalNotice}
  docLang={translated ? undefined : "en"}
  langs={LEGAL_LANGS}
  canonicalLang={translated ? undefined : "en"}
/>
