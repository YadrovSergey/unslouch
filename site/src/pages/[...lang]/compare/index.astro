---
import Base from "../../../layouts/Base.astro";
import Cta from "../../../components/Cta.astro";
import { href, langPaths, t, fill, type Lang } from "../../../i18n";
import { COMPETITORS, ROWS, appText, ours } from "../../../lib/competitors";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const c = d.compare;
---

<Base lang={lang} path="/compare/" title={d.meta.compare.title} description={d.meta.compare.description}>
  <div class="wrap">
    <div class="page-head">
      <nav class="crumbs" aria-label="breadcrumbs"><a href={href(lang, "/")}>{d.nav.home}</a></nav>
      <h1>{c.title}</h1>
      <p class="lead">{c.lead}</p>
    </div>
    <div class="table-wrap" tabindex="0" role="region" aria-label={c.title}>
      <table class="compare">
        <thead>
          <tr>
            <th scope="col">{c.feature}</th>
            <th scope="col" class="ours">{d.name}</th>
            {COMPETITORS.map((x) => <th scope="col"><a href={href(lang, `/compare/${x.slug}/`)}>{x.name}</a></th>)}
          </tr>
        </thead>
        <tbody>
          {
            ROWS.map((row) => (
              <tr>
                <th scope="row">{c.rows[row]}</th>
                <td class="ours">{ours(lang, row)}</td>
                {COMPETITORS.map((x) => {
                  const cell = appText(lang, x).cell(row);
                  return cell ? <td>{cell}</td> : <td class="none"><span class="visually-hidden">{c.empty}</span></td>;
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="tool-note">{c.checked}</p>

    <h2 style="margin-top:40px">{c.pagesTitle}</h2>
    <ul class="grid grid--3 tool-grid" style="list-style:none;padding:0;margin:16px 0 0">
      {
        COMPETITORS.map((x) => (
          <li>
            <a class="card" href={href(lang, `/compare/${x.slug}/`)}>
              <h3>{fill(c.alternative, { name: x.name })}</h3>
              <p>{appText(lang, x).summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <Cta lang={lang} />
  </div>
</Base>
