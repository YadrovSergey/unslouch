---
import ToolPage from "../../../layouts/ToolPage.astro";
import { SOURCES } from "@app/lib/sources";
import { app, langPaths, t, type Lang } from "../../../i18n";
import { islandText } from "../../../lib/islandText";
import { ANCHORS, EXTRA_SOURCES } from "../../../lib/science";
import FocusTimer from "../../../components/islands/FocusTimer";
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const a = app(lang);
const d = t(lang);
const text = islandText(lang);
const anchors = ANCHORS[lang];
---

<ToolPage lang={lang} tool="focus" why={d.tools.focus.why} sources={[EXTRA_SOURCES.albulescu, SOURCES.hands[0], SOURCES.eyes[2]]} anchor={anchors.micro}>
  <FocusTimer client:load text={text} t={d.tools.focus} common={d.common} />
</ToolPage>
