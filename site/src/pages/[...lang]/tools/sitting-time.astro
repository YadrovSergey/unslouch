---
import ToolPage from "../../../layouts/ToolPage.astro";
import { SOURCES } from "@app/lib/sources";
import { app, langPaths, t, type Lang } from "../../../i18n";
import { islandText } from "../../../lib/islandText";
import { ANCHORS, EXTRA_SOURCES } from "../../../lib/science";
import SittingCalc from "../../../components/islands/SittingCalc";
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const a = app(lang);
const d = t(lang);
const text = islandText(lang);
const anchors = ANCHORS[lang];
---

<ToolPage
  lang={lang}
  tool="sitting"
  why={[...d.tools.sitting.guidance, d.tools.sitting.notDiagnosis]}
  doctor={a.why.legs.doctor}
  sources={[SOURCES.back[1], SOURCES.back[0], SOURCES.legs[1], SOURCES.legs[0]]}
  anchor={anchors.back}
>
  <SittingCalc client:load t={d.tools.sitting} lang={lang} />
</ToolPage>
