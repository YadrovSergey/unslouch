---
import ToolPage from "../../../layouts/ToolPage.astro";
import { SOURCES } from "@app/lib/sources";
import { app, langPaths, t, type Lang } from "../../../i18n";
import { islandText } from "../../../lib/islandText";
import { ANCHORS, EXTRA_SOURCES } from "../../../lib/science";
import Generator from "../../../components/islands/Generator";
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const a = app(lang);
const d = t(lang);
const text = islandText(lang);
const anchors = ANCHORS[lang];
---

<ToolPage
  lang={lang}
  tool="generator"
  why={[a.why.neck.text, a.why.hands.text]}
  doctor={a.why.neck.doctor}
  sources={[SOURCES.neck[0], SOURCES.neck[1], SOURCES.hands[0]]}
  anchor={anchors.neck}
>
  <Generator client:load text={text} t={d.tools.generator} sections={d.sections} />
</ToolPage>
