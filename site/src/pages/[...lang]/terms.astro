---
import Doc from "../../layouts/Doc.astro";
import * as en from "../../../../legal/terms.en.md";
import * as ru from "../../../../legal/terms.ru.md";
import { langPaths, t, type Lang } from "../../i18n";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const md = { en, ru }[lang];
const d = t(lang);
const html = await md.compiledContent();
---

<Doc lang={lang} path="/terms/" title={d.meta.terms.title} description={d.meta.terms.description} html={html} />
