---
import { href, t, type Lang } from "../i18n";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang).cookieBanner;
---

<!--
  Opt-out model, the site owner's decision (he knows 152-FZ and GDPR prefer consent before any cookie and
  accepts that risk): Yandex Metrica loads on every page view unless localStorage "unslouch.consent" is "no".
  On the first visit (no saved choice) the notice explains the counter: "OK" saves "yes" and hides it,
  "Decline" saves "no", removes the _ym cookies and reloads so the counter is gone. "Cookies and statistics"
  in the footer opens the notice again. No <noscript> pixel: without JS there would be no way to decline.
-->
<div class="consent" id="consent" role="region" aria-label={t(lang).footer.cookies} hidden>
  <p>
    {c.text}{" "}
    <a href={href(lang, "/consent/")}>{c.consent}</a> · <a href={href(lang, "/privacy/")}>{c.privacy}</a>
  </p>
  <div class="consent__actions">
    <button class="btn" type="button" data-consent="no">{c.decline}</button>
    <button class="btn is-primary" type="button" data-consent="yes">{c.ok}</button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = "unslouch.consent";
    var ID = 113120121;
    var bar = document.getElementById("consent");
    function get() {
      try { return localStorage.getItem(KEY); } catch (e) { return null; }
    }
    function set(v) {
      try { localStorage.setItem(KEY, v); } catch (e) {}
    }
    function load() {
      if (window.ym) return;
      (function (m, e, t, r, i, k, a) {
        m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) return; }
        (k = e.createElement(t)), (a = e.getElementsByTagName(t)[0]), (k.async = 1), (k.src = r), a.parentNode.insertBefore(k, a);
      })(window, document, "script", "https://mc.yandex.ru/metrika/tag.js?id=" + ID, "ym");
      window.ym(ID, "init", {
        ssr: true,
        clickmap: true,
        referrer: document.referrer,
        url: location.href,
        accurateTrackBounce: true,
        trackLinks: true,
      });
    }
    // Metrica sets its cookies on this host or a parent domain (.health-diet.ru), and keeps a few _ym keys in
    // localStorage. On "Decline" all of them are removed; cookies on Yandex's own domains are out of reach.
    function dropCookies() {
      var parts = location.hostname.split(".");
      var domains = [""];
      for (var i = 0; i < parts.length - 1; i++) domains.push("; domain=." + parts.slice(i).join("."));
      document.cookie.split(";").forEach(function (c) {
        var name = c.split("=")[0].trim();
        if (name.indexOf("_ym") !== 0) return;
        domains.forEach(function (d) { document.cookie = name + "=; Max-Age=0; path=/" + d; });
      });
      try {
        Object.keys(localStorage).forEach(function (k) { if (k.indexOf("_ym") === 0) localStorage.removeItem(k); });
      } catch (e) {}
    }
    var state = get();
    if (state !== "no") load();
    if (state !== "no" && state !== "yes") bar.hidden = false;
    bar.addEventListener("click", function (e) {
      var v = e.target && e.target.getAttribute && e.target.getAttribute("data-consent");
      if (!v) return;
      var was = get();
      set(v);
      bar.hidden = true;
      if (v === "yes") { if (was === "no") load(); }
      else if (was !== "no") { dropCookies(); location.reload(); }
    });
    // "Cookies and statistics" in the footer opens the notice again.
    document.querySelectorAll("[data-open-consent]").forEach(function (b) {
      b.addEventListener("click", function () { bar.hidden = false; bar.querySelector("[data-consent='yes']").focus(); });
    });
  })();
</script>
