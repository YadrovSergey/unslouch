---
import "../styles/tokens.css";
import "../styles/figures.css";
import "../styles/site.css";
import { GITHUB, EMAIL, LANGS, LANG_NAMES, absolute, href, t, urlCode, type Lang } from "../i18n";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  lang: Lang;
  /** Language-neutral path of this page, e.g. "/tools/desk-height/". */
  path: string;
  title: string;
  description: string;
  /** false for pages that exist in one language only (404). */
  alternates?: boolean;
  noindex?: boolean;
  /** Languages this page is really translated into (hreflang). Legal pages: English and Russian only. */
  langs?: readonly Lang[];
  /** Canonical language when this page shows another language's text (legal pages outside `langs`). */
  canonicalLang?: Lang;
}

const { lang, path, title, description, alternates = true, noindex = false, langs = LANGS, canonicalLang = lang } = Astro.props;
const d = t(lang);
const canonical = absolute(canonicalLang, path);
// hreflang only on pages that are one of the translations; a legal page shown in English under /de/ has none.
const hreflang = alternates && langs.includes(lang) && canonicalLang === lang;
const ogImage = new URL(`/og-${lang === "ru" ? "ru" : "en"}.png`, "https://unslouch.health-diet.ru").toString();
// The language menu lists every language by its own name, Russian and English first.
const menuLangs: Lang[] = ["ru", "en", ...LANGS.filter((l) => l !== "ru" && l !== "en")];
const shortCode = (l: Lang) => l.split("-")[0].toUpperCase();
const nav = [
  { path: "/tools/", label: d.nav.tools },
  { path: "/app/", label: d.nav.browser },
  { path: "/science/", label: d.nav.science },
  { path: "/compare/", label: d.nav.compare },
];
const current = (p: string) => (path === p || (p !== "/" && path.startsWith(p)) ? "page" : undefined);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      hreflang && langs.map((l) => <link rel="alternate" hreflang={l} href={absolute(l, path)} />)
    }
    {hreflang && <link rel="alternate" hreflang="x-default" href={absolute("en", path)} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={d.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={d.locale.replace("-", "_")} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161a18" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    {
      lang === "en" && alternates && (
        <script is:inline define:vars={{ supported: LANGS.map(urlCode) }}>
          // First visit: open the same page in the browser's language before it renders. A language picked in the
          // language menu always wins, and crawlers are never redirected, so the English pages stay in search.
          (function () {
            try {
              var saved = null;
              try { saved = localStorage.getItem("unslouch.lang"); } catch (e) {}
              if (saved === "en") return;
              if (/bot|crawl|spider|slurp|lighthouse|headless|preview/i.test(navigator.userAgent)) return;
              var pick = saved && supported.indexOf(saved) > 0 ? saved : null;
              if (!pick && !saved) {
                var list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ""];
                for (var i = 0; i < list.length && !pick; i++) {
                  var tag = String(list[i] || "").toLowerCase();
                  var base = tag.split("-")[0];
                  var code = base === "pt" ? "pt-br" : base === "zh" ? "zh-cn" : base;
                  if (code === "en") break;
                  if (supported.indexOf(code) > 0) pick = code;
                }
              }
              if (pick) location.replace("/" + pick + location.pathname + location.search + location.hash);
            } catch (e) {}
          })();
        </script>
      )
    }
    <script is:inline>
      try {
        var saved = localStorage.getItem("unslouch.theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{d.skip}</a>
    <header class="header">
      <div class="wrap header__row">
        <a class="logo" href={href(lang, "/")}>
          <img src="/icon-192.png" alt="" width="32" height="32" />
          <span>{d.name}</span>
        </a>
        <nav class="nav" aria-label={d.nav.menu}>
          {nav.map((n) => <a href={href(lang, n.path)} aria-current={current(n.path)}>{n.label}</a>)}
        </nav>
        <div class="header__tools">
          <a class="btn btn--primary btn--small header__download" href={`${href(lang, "/")}#download`}>{d.nav.download}</a>
          <details class="menu lang-menu">
            <summary class="icon-btn" aria-label={`${d.nav.language}: ${LANG_NAMES[lang]}`} title={d.nav.language}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"></path></svg>
              <span class="lang-menu__code">{shortCode(lang)}</span>
            </summary>
            <nav class="menu__panel lang-menu__panel" aria-label={d.nav.language}>
              {
                menuLangs.map((l) => (
                  <a class="lang-switch" href={href(l, path)} hreflang={l} lang={l} data-lang={urlCode(l)} aria-current={l === lang ? "true" : undefined}>
                    {LANG_NAMES[l]}
                  </a>
                ))
              }
            </nav>
          </details>
          <button class="icon-btn theme-toggle" type="button" aria-label={d.nav.theme} title={d.nav.theme}>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          </button>
          <details class="menu">
            <summary class="icon-btn" aria-label={d.nav.menu}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
            </summary>
            <nav class="menu__panel" aria-label={d.nav.menu}>
              <a href={href(lang, "/")}>{d.nav.home}</a>
              {nav.map((n) => <a href={href(lang, n.path)} aria-current={current(n.path)}>{n.label}</a>)}
              <a href={`${href(lang, "/")}#download`}>{d.nav.download}</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer__grid">
        <div>
          <a class="logo" href={href(lang, "/")}>
            <img src="/icon-192.png" alt="" width="32" height="32" loading="lazy" />
            <span>{d.name}</span>
          </a>
          <p>{d.footer.tagline}</p>
          <p>{d.footer.notDoctor}</p>
          <p><a href={href(lang, "/terms/")}>{d.footer.asIs}</a></p>
        </div>
        <ul>
          <li><a href={href(lang, "/tools/")}>{d.nav.tools}</a></li>
          <li><a href={href(lang, "/app/")}>{d.nav.browser}</a></li>
          <li><a href={href(lang, "/science/")}>{d.nav.science}</a></li>
          <li><a href={href(lang, "/compare/")}>{d.nav.compare}</a></li>
        </ul>
        <ul>
          <li><a href={href(lang, "/privacy/")}>{d.footer.privacy}</a></li>
          <li><a href={href(lang, "/terms/")}>{d.footer.terms}</a></li>
          <li><a href={href(lang, "/consent/")}>{d.footer.consent}</a></li>
          <li><button class="linklike" type="button" data-open-consent>{d.footer.cookies}</button></li>
          <li><a href={GITHUB}>{d.footer.source}</a></li>
          <li><a href={`mailto:${EMAIL}`}>{d.footer.contact}: {EMAIL}</a></li>
          <li><a href={`${GITHUB}/issues/new?template=bug.yml`}>{d.footer.bug}</a></li>
          <li><a href={href(lang, "/donate/")}>{d.footer.donate}</a></li>
          <li class="muted">{d.footer.author}</li>
        </ul>
      </div>
    </footer>

    <CookieConsent lang={lang} />

    <script is:inline>
      // The language menu remembers the choice, so the automatic language pick never overrides it.
      document.querySelectorAll(".lang-switch").forEach(function (a) {
        a.addEventListener("click", function () {
          try { localStorage.setItem("unslouch.lang", a.getAttribute("data-lang")); } catch (e) {}
        });
      });
      // Header menus: Escape closes and returns focus to the button, a click outside closes, one open at a time.
      (function () {
        var menus = document.querySelectorAll(".header details.menu");
        menus.forEach(function (m) {
          m.addEventListener("toggle", function () {
            if (!m.open) return;
            menus.forEach(function (o) { if (o !== m) o.open = false; });
            var current = m.querySelector("[aria-current]") || m.querySelector(".menu__panel a");
            if (m.classList.contains("lang-menu") && current && m.matches(":focus-within")) current.focus();
          });
          m.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && m.open) {
              m.open = false;
              m.querySelector("summary").focus();
            }
            if ((e.key === "ArrowDown" || e.key === "ArrowUp") && m.open) {
              var links = Array.prototype.slice.call(m.querySelectorAll(".menu__panel a"));
              var i = links.indexOf(document.activeElement);
              var next = e.key === "ArrowDown" ? (i + 1) % links.length : (i <= 0 ? links.length - 1 : i - 1);
              links[next].focus();
              e.preventDefault();
            }
          });
        });
        document.addEventListener("click", function (e) {
          menus.forEach(function (m) { if (m.open && !m.contains(e.target)) m.open = false; });
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.querySelector(".theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var dark = root.dataset.theme
            ? root.dataset.theme === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          var next = dark ? "light" : "dark";
          root.dataset.theme = next;
          try {
            localStorage.setItem("unslouch.theme", next);
          } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
