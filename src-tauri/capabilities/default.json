{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window: files through native dialogs, autostart, links",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "opener:default",
    "autostart:default",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
